---
import '../theme/theme.css';
import '../styles/template.css';
import { CATEGORIES, SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  noIndex?: boolean;
  ogType?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  tags?: string[];
}

const {
  title = SITE.title,
  description = SITE.description,
  image = null,
  imageAlt,
  imageWidth,
  imageHeight,
  noIndex = false,
  ogType = 'website',
  publishedAt,
  updatedAt,
  tags = [],
} = Astro.props;

const pageTitle = title === SITE.title ? title : `${title} — ${SITE.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = image ? new URL(image, Astro.site) : null;
const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/posts/', label: 'ノート', icon: '⌂' },
  ...Object.entries(CATEGORIES).map(([key, category]) => ({
    href: `/category/${key}/`,
    label: category.label,
    icon: category.icon,
  })),
  { href: '/search/', label: '検索', icon: '⌕' },
  { href: '/about/', label: 'このブログ', icon: '●' },
];
const isActive = (href: string) => {
  if (href === '/posts/') return currentPath.startsWith('/posts/');
  return currentPath.startsWith(href);
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {socialImage && imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {socialImage && imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label={`${SITE.title} ホーム`}>
          <span class="brand-mark" aria-hidden="true"></span>
          <span>{SITE.title}</span>
        </a>
        <nav class="site-nav" aria-label="メインナビゲーション">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={{ active: isActive(item.href) }}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              <span class="nav-icon" aria-hidden="true">{item.icon}</span>
              {item.label}
            </a>
          ))}
        </nav>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer">
        <p><span class="brand-mark" aria-hidden="true"></span>{SITE.description}</p>
        <div class="footer-links">
          <a href="/rss.xml">RSS</a>
          <span class="footer-meta">© {new Date().getFullYear()} {SITE.author}</span>
        </div>
      </footer>
    </div>
  </body>
</html>
